# 이 파일을 ".env"로 복사한 뒤 필요한 줄만 고치세요. .env는 git에 올라가지 않습니다.
# 아무것도 설정하지 않아도 동작합니다(글 대본 정리는 규칙 기반, 음성은 Whisper가 설치된 경우에만).

# ── AI(LLM): 규칙이 놓친 항목을 제안하고 요약을 다듬습니다. 모든 결과는 검증을 통과해야 반영됩니다. ──
# auto(기본: Claude 키 → OpenAI 키 → 로컬 Ollama) | anthropic | openai | ollama | off
# 회의 내용이 외부로 나가지 않게 하려면 ollama 를 쓰세요(아래 두 줄의 # 을 지움).
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=kanana2:3b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── 받아쓰기(Whisper, 로컬) ──
# WHISPER_MODEL=small        # tiny | base | small | medium (클수록 정확하고 느림, 첫 실행 때 모델을 내려받음)
# WHISPER_MODELS_DIR=        # 모델 저장 폴더(기본: 프로젝트의 models/)
# PYTHON=python              # faster-whisper가 설치된 파이썬
# FFMPEG_PATH=ffmpeg
# STT_TIMEOUT_MS=1800000     # 받아쓰기 제한 시간(30분)

# ── 서버 ──
# PORT=5500
# HOST=127.0.0.1             # 바꾸면 같은 네트워크의 다른 사람도 접속 가능 → 로그인이 없으므로 권장하지 않음
# MAX_AUDIO_MB=100
